{
  "name": "Projaska · Actualizar dólar cada hora",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      },
      "id": "6f1c2a10-0b1e-4c7a-9a01-000000000001",
      "name": "Cada 1 hora",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://projaska.com/api/dollar-rate/refresh",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          },
          "timeout": 30000
        }
      },
      "id": "6f1c2a10-0b1e-4c7a-9a01-000000000002",
      "name": "Actualizar dólar",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 0],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "6f1c2a10-0b1e-4c7a-9a01-0000000000c1",
              "leftValue": "={{ $json.statusCode }}",
              "rightValue": 200,
              "operator": {
                "type": "number",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "6f1c2a10-0b1e-4c7a-9a01-000000000003",
      "name": "¿Falló?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [480, 0]
    },
    {
      "parameters": {
        "sendTo": "info.projaska@gmail.com",
        "subject": "=Projaska: no se actualizó el dólar ({{ $json.statusCode ?? 'sin respuesta' }})",
        "emailType": "text",
        "message": "=La actualización automática del dólar no se aplicó.\n\nCódigo: {{ $json.statusCode ?? 'sin respuesta' }}\nDetalle: {{ $json.body?.reason ?? $json.body?.error ?? $json.error?.message ?? JSON.stringify($json.body ?? $json) }}\n\n409 = el cambio superó el 25%: revisalo y cargalo a mano en Configuración.\n401 = la API key de n8n no coincide con PRICE_SYNC_API_KEY en Vercel.\n502 = dolarapi.com no respondió; se reintenta en la próxima hora.",
        "options": {}
      },
      "id": "6f1c2a10-0b1e-4c7a-9a01-000000000004",
      "name": "Avisar por mail",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [720, -100]
    },
    {
      "parameters": {},
      "id": "6f1c2a10-0b1e-4c7a-9a01-000000000005",
      "name": "OK",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [720, 100]
    }
  ],
  "connections": {
    "Cada 1 hora": {
      "main": [[{ "node": "Actualizar dólar", "type": "main", "index": 0 }]]
    },
    "Actualizar dólar": {
      "main": [[{ "node": "¿Falló?", "type": "main", "index": 0 }]]
    },
    "¿Falló?": {
      "main": [
        [{ "node": "Avisar por mail", "type": "main", "index": 0 }],
        [{ "node": "OK", "type": "main", "index": 0 }]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "America/Argentina/Buenos_Aires"
  },
  "pinData": {}
}
