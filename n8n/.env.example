# ============ PRECIOS (lo que vas a tocar seguido) ============
# Moneda en la que tu base guarda el precio. Projaska guarda el COSTO en USD
TARGET_CURRENCY=USD
# % sobre el precio de la fuente. En Projaska va 0: el margen y los pesos los calcula la tienda
PRICE_MARGIN_PCT=0
# Redondeo del precio final. 0.01 = centavos (USD) | 100 = redondear a $100 (ARS)
PRICE_ROUND_TO=0.01
# Si el cambio supera este %, NO actualiza y lo marca para revisión manual
MAX_CHANGE_PCT=30
# Confianza mínima (0 a 1) de Ollama para considerar que es el mismo producto
MIN_CONFIDENCE=0.8
# true = solo calcula y muestra; no toca tu sitio. Pasalo a false cuando confíes
DRY_RUN=true

# IVA a sumar al precio de la fuente (Lococo publica SIN IVA). En Projaska va 0 (costo sin IVA)
ADD_IVA_PCT=0
# Cotización del dólar, solo si hay que convertir. Vacío = usa la que publica Lococo
USD_RATE=

# ============ FUENTE DE PRECIOS ============
# lococo = modo listo para importadoralococo.com | generic = cualquier sitio con selectores CSS
COMPETITOR_SOURCE=lococo
COMPETITOR_URLS=https://importadoralococo.com/lista-de-precios
# Solo para COMPETITOR_SOURCE=generic:
COMPETITOR_ITEM_SEL=.product-card
COMPETITOR_NAME_SEL=.product-title
COMPETITOR_PRICE_SEL=.price
COMPETITOR_LINK_SEL=a
COMPETITOR_STEALTH=false

# ============ SINCRONIZACIÓN ============
# model = empareja tu "model" con el código de Lococo (carga inicial) | sku = empareja por SKU (mantenimiento)
SYNC_MODE=model
# En modo model, pisa tu SKU con el código de Lococo
UPDATE_SKU=true
# Pisa tu descripción con la de Lococo
UPDATE_DESCRIPTION=true

# ============ TU SITIO ============
MY_PRODUCTS_URL=https://projaska.com/api/price-sync/products
MY_UPDATE_URL=https://projaska.com/api/price-sync/update
# El mismo valor que PRICE_SYNC_API_KEY en Vercel
MY_API_KEY=cambiame

# ============ IA (cualquier API compatible con OpenAI) ============
# Groq (gratis): creá la key en console.groq.com/keys
LLM_URL=https://api.groq.com/openai/v1/chat/completions
LLM_API_KEY=gsk_tu_key
LLM_MODEL=llama-3.3-70b-versatile
# Pausa entre pedidos (ms). Groq free = 30 pedidos/min -> 2500 deja margen
LLM_INTERVAL_MS=2500

# Para volver a Ollama local: docker compose --profile ollama up -d y usá
# LLM_URL=http://ollama:11434/v1/chat/completions  LLM_API_KEY=ollama  LLM_MODEL=qwen2.5:7b  LLM_INTERVAL_MS=0
