# ============ MODO PRUEBA ============
# true = calcula todo y te lo muestra en "Armar operaciones", pero NO toca tu tienda
DRY_RUN=true

# ============ PRECIOS ============
# Projaska guarda el COSTO en USD sin IVA: dejá margen 0 e IVA 0, la tienda calcula el precio de venta
TARGET_CURRENCY=USD
PRICE_MARGIN_PCT=0
ADD_IVA_PCT=0
# 0.01 = centavos (USD) | 100 = redondear a $100 (ARS)
PRICE_ROUND_TO=0.01
# Si el precio cambia más que este %, NO lo aplica y lo lista en "revisar_a_mano"
MAX_CHANGE_PCT=30
# Cotización solo si hay que convertir moneda. Vacío = usa la que publica Lococo
USD_RATE=

# ============ CATÁLOGO ============
# Productos nuevos de Lococo: true = se publican al toque | false = se crean ocultos para revisarlos
PUBLISH_NEW=true
# true = no crea un producto hasta tener su ficha (categoría + características)
CREATE_ONLY_WITH_DETAILS=true
# Fichas a bajar por corrida (~2 s cada una). Para la CARGA INICIAL ponelo en 1000 (tarda ~30 min)
DETAILS_MAX_PER_RUN=300
# Fichas por request al scraper (tandas cortas, se ve el avance en n8n)
DETAILS_CHUNK=40
# Tope de segundos por tanda; lo que no entra queda para la próxima corrida
DETAILS_TIME_BUDGET_S=600
# true = desactiva (no borra) tus productos que Lococo dejó de listar
DEACTIVATE_MISSING=true
# Si el scraping trae menos que esto, el flujo frena (protege contra un scraping roto)
MIN_SCRAPE_COUNT=800
# Estados de Lococo que cuentan como "hay stock"
IN_STOCK_STATUSES=inmediato,deposito_2,tercer_deposito
# false = precio y stock siempre; nombre/marca/categoría/ficha/foto solo si están vacíos (respeta lo que edites a mano)
# true  = pisa todo con lo de Lococo en cada corrida
OVERWRITE_CONTENT=false
# title = "Cámara Domo Analógica Dahua · 2 MP" | original = "CÁMARA DOMO ANALÓGICA DAHUA · 2 MP"
NAME_STYLE=title
# Productos por request al endpoint de tu tienda
BATCH_SIZE=50
# (Opcional) Lista de marcas a detectar en el nombre, separadas por coma. Vacío = lista por defecto del scraper
BRANDS=

# ============ FUENTE ============
COMPETITOR_SOURCE=lococo
COMPETITOR_URLS=https://importadoralococo.com/lista-de-precios

# ============ TU TIENDA ============
MY_PRODUCTS_URL=https://projaska.com/api/price-sync/products
MY_UPSERT_URL=https://projaska.com/api/price-sync/upsert
# El mismo valor que PRICE_SYNC_API_KEY en Vercel
MY_API_KEY=cambiame

# --- Reporte por Telegram al terminar ---
# Token del bot (lo da @BotFather) y tu chat id (mandale un mensaje al bot y abrí
# https://api.telegram.org/bot<TOKEN>/getUpdates → "chat":{"id": ...})
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Manda el ID de Lococo (sourceId = prod_…) y el link a su ficha (sourceUrl). Matchea primero por ID y después por modelo.
SEND_SOURCE_FIELDS=true
