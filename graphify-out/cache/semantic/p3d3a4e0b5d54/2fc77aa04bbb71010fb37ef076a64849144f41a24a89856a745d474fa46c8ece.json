{"nodes": [{"id": "design_viewfinder_north_star", "label": "The Viewfinder (Creative North Star)", "file_type": "rationale", "source_file": "DESIGN.md", "source_location": "L119-132", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Store seen through a camera viewfinder; persuasion from shown data (OSD readouts), not soft heroes, icon tiles or shadowed cards. Dark world scoped by .store wrapper; admin keeps own light/dark system."}, {"id": "design_store_scope", "label": ".store wrapper scope", "file_type": "concept", "source_file": "DESIGN.md", "source_location": "L123", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Storefront tokens apply only under .store so the admin area's light/dark system is untouched."}, {"id": "design_color_palette", "label": "Instrument Color Palette (letterbox, hud, osd, pj, caution, plate)", "file_type": "concept", "source_file": "DESIGN.md", "source_location": "L4-15,L134-152", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Near-black instrument palette with one blue for action and one amber for caution. HUD Gray darker than contract #22272B for contrast; OSD Dim #9aa2a8 holds >=6:1 on black."}, {"id": "design_lens_blue", "label": "Lens Blue (pj #1479bc)", "file_type": "concept", "source_file": "DESIGN.md", "source_location": "L138-141", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Logo blue used only as primary-action fill; pj-ink used for blue text on black since base blue is illegible there."}, {"id": "design_caution_amber_rule", "label": "The Caution Amber Rule", "file_type": "rationale", "source_file": "DESIGN.md", "source_location": "L155", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Amber marks only functional roles: zoom bar, low stock/made-to-order, locked brackets, input focus, errors, PENDING status, keyboard focus outline. Decorative amber banned."}, {"id": "design_one_action_rule", "label": "The One Action Rule", "file_type": "rationale", "source_file": "DESIGN.md", "source_location": "L157", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lens Blue fills primary actions only; secondary actions are ghost buttons with bracket hover."}, {"id": "design_lit_plate_rule", "label": "The Lit Plate Rule", "file_type": "rationale", "source_file": "DESIGN.md", "source_location": "L159", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Photos sit on the light plate with multiply so supplier white backgrounds merge; photo-less wells stay HUD Gray with a dim lucide glyph."}, {"id": "design_typography_system", "label": "Typography: Share Tech Mono + Geist", "file_type": "concept", "source_file": "DESIGN.md", "source_location": "L16-61,L161-178", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Segmented camera OSD face for readouts; neutral grotesque (Geist) for sentences and names. Share Tech Mono loaded via next/font as --font-share-tech-mono in store layout."}, {"id": "design_readout_rule", "label": "The Readout Rule", "file_type": "rationale", "source_file": "DESIGN.md", "source_location": "L181", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Anything a camera would overlay (SKU, stock, count, price, rate, date, channel) is OSD uppercase tabular tracked; names and sentences are Geist normal case. 11px is the floor."}, {"id": "design_layout_grid", "label": "Layout: 1440px column, 2-5 col catalog grid", "file_type": "concept", "source_file": "DESIGN.md", "source_location": "L183-187", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_home_viewfinder_frame", "label": "Home Viewfinder Frame (hero)", "file_type": "concept", "source_file": "DESIGN.md", "source_location": "L185", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Full-bleed frame with large brackets and three bands: top readouts (REC, reference rate), headline + featured kit split, bottom readouts (counts, zoom bar, installation contact)."}, {"id": "design_no_lift_rule", "label": "The No-Lift Rule", "file_type": "rationale", "source_file": "DESIGN.md", "source_location": "L194", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No box-shadow, blur or gradient fills; depth is tonal and state changes move brackets, not surfaces."}, {"id": "design_corner_brackets", "label": "Corner Brackets", "file_type": "concept", "source_file": "DESIGN.md", "source_location": "L127,L196-198", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Brackets replace boxes, borders and focus rings; painted as background-image gradients (no extra DOM), colored via one custom property; sizes small/large/focus. Closed amber pair = locked."}, {"id": "design_camera_motion", "label": "Camera-like Motion (single-frame cuts)", "file_type": "rationale", "source_file": "DESIGN.md", "source_location": "L125,L252", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "State changes are hard cuts with no color/height/opacity transitions; only the stepped REC blink and loading spinner animate."}, {"id": "design_zebra_stripe", "label": "Zebra Stripe (out of stock / overexposed)", "file_type": "concept", "source_file": "DESIGN.md", "source_location": "L123,L215,L254", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The only texture; reserved exclusively for out-of-stock."}, {"id": "design_buttons", "label": "Buttons (primary / ghost instrument keys)", "file_type": "concept", "source_file": "DESIGN.md", "source_location": "L76-88,L202-207", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_cards", "label": "Cards / Containers", "file_type": "concept", "source_file": "DESIGN.md", "source_location": "L95-106,L209-215", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_inputs", "label": "Inputs / Fields", "file_type": "concept", "source_file": "DESIGN.md", "source_location": "L89-94,L217-220", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_navigation", "label": "Navigation (OSD links, cart, mobile)", "file_type": "concept", "source_file": "DESIGN.md", "source_location": "L222-226", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_zoom_bar", "label": "Zoom Bar (W-T depth scale)", "file_type": "concept", "source_file": "DESIGN.md", "source_location": "L225", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Amber tick shows navigation depth: W = catalog, T = product/kit detail. aria-hidden."}, {"id": "design_channel_bar", "label": "Channel Bar (signature component)", "file_type": "concept", "source_file": "DESIGN.md", "source_location": "L228-229", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sticky strip treating each category as a TV channel; CH nn/NN counter follows scroll via IntersectionObserver; active channel locked with amber brackets."}, {"id": "design_stock_readout", "label": "Stock Readout", "file_type": "concept", "source_file": "DESIGN.md", "source_location": "L231-232", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_quantity_stepper", "label": "Quantity Stepper", "file_type": "concept", "source_file": "DESIGN.md", "source_location": "L234-235", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_rec_readout", "label": "REC Readout (blinking dot)", "file_type": "concept", "source_file": "DESIGN.md